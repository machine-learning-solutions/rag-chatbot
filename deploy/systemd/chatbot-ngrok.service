[Unit]
Description=Chatbot - ngrok tunnel to gateway (port 9080)
# Do NOT After=chatbot.service — that oneshot recover can block for minutes
# and also cannot systemctl-start us (polkit). wait-for-gateway.sh is enough.
After=network-online.target docker.service voice-phone-control-ngrok.service n8n-ngrok.service
Wants=network-online.target docker.service
# Free ngrok allows one agent tunnel — chatbot claims it on boot and stops
# the other ngrok units if they raced ahead.
Conflicts=n8n-ngrok.service voice-phone-control-ngrok.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/home/jadaboawwad/Files/Software/Repositories/Applications/Portfolio/chatbot/deploy/systemd/wait-for-gateway.sh
ExecStart=/usr/local/bin/ngrok start chatbot
User=jadaboawwad
Group=jadaboawwad
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
